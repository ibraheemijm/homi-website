import BaseLayout from "../../../layouts/BaseLayout.astro";
---
<BaseLayout lang="en" title="Privacy policy" description="How Homi handles personal information.">
  <section class="page-hero"><div class="container"><h1>Privacy policy</h1><p class="lead">We aim to process only the information needed to provide the service and manage licenses.</p></div></section>
  <section class="content"><div class="container content-narrow">
    <h2>Information we may process</h2><ul><li>Customer or store name and phone number submitted with a subscription request.</li><li>Application, platform, and application version identifiers.</li><li>Device public key, fingerprint, and activation request identifier.</li><li>Subscription, license, and manually recorded payment information.</li></ul>
    <h2>Information not collected for activation</h2><p>The platform does not need sales, inventory, customer debt records, or the local Homi Grocery database to activate the application.</p>
    <h2>Purpose and retention</h2><p>Information is used to review requests, manage devices and subscriptions, issue licenses, and prevent abuse. It is retained only as long as needed for those purposes and applicable obligations.</p>
    <h2>Security</h2><p>Administrative access controls and audit logs protect platform data. Private license-signing keys remain on the server and are never embedded in the client application.</p>
    <h2>Contact</h2><p>For privacy questions: <a href="tel:+2490904697455">+249 090 469 7455</a>.</p>
    <p class="muted">This is an initial draft and requires final review before launch.</p>
  </div></section>
</BaseLayout>
